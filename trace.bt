uprobe:$3:standard_ExecutorStart /pid==$2/
{
 printf("%d query_id: %ld query: %s\n",pid,(uint64)(uptr(*(uptr(*(arg0+8))+8))),str(uptr(*(arg0+16))) );
}

uprobe:$3:standard_ProcessUtility /pid==$2/
{
 printf("%d Utility: %s\n",pid,str(uptr(arg1)));
}


watchpoint:$1:8:rw
{
 if (*uptr($1)!=0) {
   @wait_event=*uptr($1);
   @wait_start=nsecs;
  }
 else if(@wait_event!=0){
  printf("#WAIT %d %ld ns %s\n",@wait_event,nsecs-@wait_start,ustack(7));
  delete(@wait_event);
  delete(@wait_start);
 }
}

BEGIN{
 @script_start=nsecs;
}

END{
 printf("Script run time: %ld ms\n",(nsecs-@script_start)/1e6);
 clear(@script_start);
 clear(@wait_event);
 clear(@wait_start);
 printf("Exiting\n");
}
